---
// Página de un juego: encabezado, introducción (una vez por día) y el
// contenido del juego. La introducción y el juego se alternan con la clase
// html.intro-vista, que pone el script del <head> antes del primer pintado.
import EncabezadoJuego from "../components/EncabezadoJuego.astro";
import EstadisticasJuego from "../components/EstadisticasJuego.svelte";
import { obtenerJuego, type JuegoId } from "../lib/juegos";
import "../styles/juego.css";
import Pagina from "./Pagina.astro";
import { ruta, urlJuego } from "../lib/rutas";
import { existsSync } from "node:fs";

interface Props {
    juego: JuegoId;
    titulo: string;
    descripcion: string;
    /** Título de la introducción. */
    tituloIntro: string;
}

const { juego: id, titulo, descripcion, tituloIntro } = Astro.props;
const juego = obtenerJuego(id);
// Los juegos sin tarjeta propia para redes (public/assets/images/og) usan la de la portada.
const imagenOg = existsSync(new URL(`../../public/assets/images/og/${id}.jpg`, import.meta.url)) ? id : "portada";
---

<Pagina titulo={titulo} descripcion={descripcion} claveIntro={juego.claveIntro} {imagenOg} pieCompacto>
    <EncabezadoJuego juegoActual={id} />

    <main class={`juego juego--${id}`}>
        <div class="intro-bloque">
            <section class="presentacion-juego" aria-labelledby="titulo-intro">
                <h1 id="titulo-intro">{tituloIntro}</h1>
            </section>

            <section class="intro-juego" aria-label="Cómo se juega">
                <slot name="intro-imagen" />

                <div class="intro-juego__info">
                    <slot name="intro" />
                    <button type="button" class="intro-juego__boton" data-intro-clave={juego.claveIntro}>Empezar</button>
                    <noscript>
                        <p class="intro-juego__texto intro-juego__sin-js">TCdle necesita JavaScript para jugar. Activalo en tu navegador y volvé a cargar la página.</p>
                    </noscript>
                </div>
            </section>
        </div>

        <div class="contenido-juego">
            <!-- Solo en un día del archivo (?dia=): lo completa el script de abajo. -->
            <p class="aviso-archivo" data-aviso-archivo hidden>
                <span>Estás jugando el <b data-aviso-archivo-fecha></b>. No suma a la racha.</span>
                <a href={ruta("archivo.html")}>Archivo</a>
                <a href={urlJuego(juego.archivo)}>Volver a hoy</a>
            </p>
            <slot name="presentacion" />
            <slot />
        </div>
    </main>
    <!-- Pop up de estadísticas: se abre solo al terminar y desde el botón del encabezado. -->
    <EstadisticasJuego client:only="svelte" juego={id} />

    <script>
        import { obtenerAlmacenamiento } from "../lib/almacenamiento";
        import { marcarIntroVista } from "../lib/intro";
        import { leerDiaJuego } from "../lib/dia-juego";

        const dia = leerDiaJuego(location.search);
        const aviso = document.querySelector<HTMLElement>("[data-aviso-archivo]");
        if (dia.esArchivo && aviso) {
            const [anio, mes, numero] = dia.fecha.split("-").map(Number);
            aviso.querySelector("[data-aviso-archivo-fecha]")!.textContent = new Date(anio, mes - 1, numero).toLocaleDateString("es-AR", {
                weekday: "long",
                day: "numeric",
                month: "long",
            });
            aviso.hidden = false;
        }

        // "Empezar" recuerda que hoy ya se vio la introducción y muestra el juego.
        document.querySelector<HTMLButtonElement>("[data-intro-clave]")?.addEventListener("click", (evento) => {
            marcarIntroVista(obtenerAlmacenamiento(), (evento.currentTarget as HTMLElement).dataset.introClave!);
            document.documentElement.classList.add("intro-vista");
            // Con mouse y teclado se puede escribir enseguida; en el celular abriría el teclado sin pedirlo.
            if (window.matchMedia("(pointer: fine)").matches) {
                requestAnimationFrame(() => document.querySelector<HTMLInputElement>(".buscador input:not(:disabled)")?.focus());
            }
        });
    </script>
</Pagina>
