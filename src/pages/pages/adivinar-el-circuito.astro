---
import Circuito from "../../games/Circuito.svelte";
import CargandoJuego from "../../components/CargandoJuego.astro";
import PaginaJuego from "../../layouts/PaginaJuego.astro";
import { urlImagen } from "../../lib/rutas";
import "../../styles/desafio.css";
import "../../styles/circuito.css";
---

<PaginaJuego
    juego="circuito"
    titulo="TCdle | Adiviná el circuito"
    descripcion="Adiviná el circuito del día en el que corrió el Turismo Carretera."
    tituloIntro="¿Qué circuito es este?"
>
    <img
        slot="intro-imagen"
        class="intro-juego__imagen intro-juego__imagen--circuito"
        src={urlImagen("circuitos/balcarce.svg")}
        alt="Silueta de ejemplo de un circuito de Turismo Carretera"
        loading="lazy"
    />

    <Fragment slot="intro">
        <p class="intro-juego__texto">Tenés que reconocer el circuito por su silueta.</p>

        <p class="intro-juego__texto">
            Tenés <strong>8 intentos</strong> para descubrir de qué circuito de TC se trata. Escribí el nombre del circuito que creés que
            corresponde al trazado.
        </p>

        <p class="intro-juego__texto">
            <strong>Pista:</strong> están incluidos todos los circuitos utilizados por el TC desde 1997 hasta la actualidad.
        </p>
    </Fragment>

    <section slot="presentacion" class="presentacion-juego" aria-labelledby="titulo-circuito">
        <p class="modo-juego">Modo circuito</p>
        <h1 id="titulo-circuito">¿Qué circuito es este?</h1>
    </section>

    <Circuito client:only="svelte">
        <Fragment slot="fallback">
            <CargandoJuego forma="foto" />
        </Fragment>
    </Circuito>
</PaginaJuego>
