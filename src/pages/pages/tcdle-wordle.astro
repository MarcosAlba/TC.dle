---
import Wordle from "../../games/Wordle.svelte";
import CargandoJuego from "../../components/CargandoJuego.astro";
import PaginaJuego from "../../layouts/PaginaJuego.astro";
import { urlImagen } from "../../lib/rutas";
import "../../styles/desafio.css";
import "../../styles/wordle.css";
---

<PaginaJuego
    juego="wordle"
    titulo="TCdle | Wordle del TC"
    descripcion="Adiviná la palabra de Turismo Carretera del día, estilo Wordle."
    tituloIntro="Wordle del TC"
>
    <img
        slot="intro-imagen"
        class="intro-juego__imagen"
        src={urlImagen("ejemplos/ejemplo-wordle.webp")}
        alt="Ejemplo de un tablero del Wordle del TC ya jugado, con celdas verdes, amarillas y grises"
        width="1200"
        height="1125"
        loading="lazy"
    />

    <Fragment slot="intro">
        <p class="intro-juego__texto">Encontrá la palabra del TC, un piloto o un circuito, en <strong>6 intentos</strong>.</p>
        <ul class="intro-juego__leyenda">
            <li>
                <span class="intro-juego__chip intro-juego__chip--correcta" aria-hidden="true"></span>
                <span><strong>Verde:</strong> letra en su lugar.</span>
            </li>
            <li>
                <span class="intro-juego__chip intro-juego__chip--presente" aria-hidden="true"></span>
                <span><strong>Amarillo:</strong> está, pero en otro lugar.</span>
            </li>
            <li>
                <span class="intro-juego__chip intro-juego__chip--ausente" aria-hidden="true"></span>
                <span><strong>Gris:</strong> no está.</span>
            </li>
        </ul>
    </Fragment>

    <section slot="presentacion" class="presentacion-juego" aria-labelledby="titulo-wordle">
        <h1 id="titulo-wordle">Wordle del TC</h1>
    </section>

    <Wordle client:only="svelte">
        <Fragment slot="fallback">
            <CargandoJuego forma="wordle" />
        </Fragment>
    </Wordle>
</PaginaJuego>
