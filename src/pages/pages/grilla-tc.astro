---
// Grilla TC. Las fichas de los pilotos se bajan aparte
// (/datos/fichas-*.json, ver CargadorExtra), no van dentro del HTML.
import CargadorExtra from "../../games/extra/CargadorExtra.svelte";
import CargandoJuego from "../../components/CargandoJuego.astro";
import PaginaJuego from "../../layouts/PaginaJuego.astro";
import { urlImagen } from "../../lib/rutas";
import "../../styles/desafio.css";
import "../../styles/extra.css";

// Muestra de la introducción: la grilla de 4 × 4 con sus consignas (las mismas insignias
// del juego) y tres casilleros completos.
const insignias = import.meta.glob("../../assets/grilla/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const insignia = (id: string) => insignias["../../assets/grilla/" + id + ".svg"].replace(/href="marcas\//g, 'href="' + urlImagen("marcas/"));
const consignasArriba = [
    { insignia: insignia("santa-fe"), rotulo: "De Santa Fe" },
    { insignia: insignia("cordoba"), rotulo: "De Córdoba" },
    { insignia: insignia("gano-5"), rotulo: "5 finales" },
];
const consignasCostado = [
    { insignia: insignia("marca-torino"), rotulo: "Torino" },
    { insignia: insignia("debut-2010"), rotulo: "Debut" },
    { insignia: insignia("debut-2015"), rotulo: "Debut" },
];
const fotos = ["julian_santero", null, null, null, "agustin_canapino", null, null, null, "mariano_werner"];
---

<PaginaJuego
    juego="grilla"
    titulo="TCdle | Grilla TC"
    descripcion="Nueve casilleros: cada uno pide un piloto de TC que cumpla la consigna de su fila y la de su columna."
    tituloIntro="Grilla TC"
>
    <div slot="intro-imagen" class="intro-juego__imagen intro-extra intro-extra--grilla" aria-hidden="true">
        <span class="intro-grilla__esquina">3<small>/9</small></span>
        {consignasArriba.map((c) => <span class="intro-grilla__consigna"><span class="grilla__insignia intro-grilla__insignia" set:html={c.insignia} /><small>{c.rotulo}</small></span>)}
        {consignasCostado.map((c, fila) => (
            <>
                <span class="intro-grilla__consigna">
                    <span class="grilla__insignia intro-grilla__insignia" set:html={c.insignia} />
                    <small>{c.rotulo}</small>
                </span>
                {fotos.slice(fila * 3, fila * 3 + 3).map((foto) =>
                    foto ? <img class="intro-grilla__piloto" src={urlImagen("pilotos/mini/" + foto + ".webp")} alt="" /> : <i />
                )}
            </>
        ))}
    </div>

    <Fragment slot="intro">
        <p class="intro-juego__texto">
            Completá los nueve casilleros con pilotos que cumplan la consigna de su <strong>fila</strong> y de su <strong>columna</strong>. Escribí
            un piloto y se ubica solo. Cada piloto vale una vez.
        </p>

        <fieldset class="opciones-juego">
            <legend>Dificultad</legend>
            <label><input type="radio" name="grilla-dificultad" value="facil" /><span>Fácil</span></label>
            <label><input type="radio" name="grilla-dificultad" value="normal" checked /><span>Normal</span></label>
            <label><input type="radio" name="grilla-dificultad" value="dificil" /><span>Difícil</span></label>
        </fieldset>

        <fieldset class="opciones-juego">
            <legend>Tiempo</legend>
            <label><input type="radio" name="grilla-tiempo" value="" checked /><span>Libre</span></label>
            <label><input type="radio" name="grilla-tiempo" value="30" /><span>30 s</span></label>
            <label><input type="radio" name="grilla-tiempo" value="60" /><span>60 s</span></label>
            <label><input type="radio" name="grilla-tiempo" value="120" /><span>120 s</span></label>
        </fieldset>
    </Fragment>

    <section slot="presentacion" class="presentacion-juego" aria-labelledby="titulo-grilla">
        <h1 id="titulo-grilla">Grilla TC</h1>
    </section>

    <CargadorExtra client:only="svelte" juego="grilla" archivo="fichas-plantel.json">
        <Fragment slot="fallback">
            <CargandoJuego forma="foto" />
        </Fragment>
    </CargadorExtra>
</PaginaJuego>

<script>
    import { CLAVE_DIFICULTAD_GRILLA, CLAVE_TIEMPO_GRILLA, EVENTO_TIEMPO_GRILLA, normalizarDificultad, normalizarTiempoGrilla } from "../../lib/extra";

    // La introducción arranca con el último tiempo elegido. "Empezar" lo recuerda y se
    // lo pasa al juego, que ya está montado detrás y larga el reloj.
    const opciones = document.querySelectorAll<HTMLInputElement>('input[name="grilla-tiempo"]');
    const dificultades = document.querySelectorAll<HTMLInputElement>('input[name="grilla-dificultad"]');
    try {
        const anterior = String(normalizarTiempoGrilla(Number(localStorage.getItem(CLAVE_TIEMPO_GRILLA))) ?? "");
        opciones.forEach((opcion) => (opcion.checked = opcion.value === anterior));
        const dificultad = normalizarDificultad(localStorage.getItem(CLAVE_DIFICULTAD_GRILLA));
        dificultades.forEach((opcion) => (opcion.checked = opcion.value === dificultad));
    } catch {
        // Sin localStorage queda "Sin tiempo".
    }

    document.querySelector<HTMLButtonElement>("[data-intro-clave]")?.addEventListener("click", () => {
        const elegido = [...opciones].find((opcion) => opcion.checked)?.value ?? "";
        const segundos = normalizarTiempoGrilla(elegido === "" ? null : Number(elegido));
        const dificultad = normalizarDificultad([...dificultades].find((opcion) => opcion.checked)?.value);
        try {
            // La grilla lee la dificultad de acá al recibir el evento.
            localStorage.setItem(CLAVE_DIFICULTAD_GRILLA, dificultad);
            if (segundos === null) {
                localStorage.removeItem(CLAVE_TIEMPO_GRILLA);
            } else {
                localStorage.setItem(CLAVE_TIEMPO_GRILLA, String(segundos));
            }
        } catch {
            // Sin localStorage vale solo para hoy.
        }
        document.dispatchEvent(new CustomEvent(EVENTO_TIEMPO_GRILLA, { detail: segundos }));
    });
</script>
