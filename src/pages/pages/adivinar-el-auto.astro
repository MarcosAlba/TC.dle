---
import Auto from "../../games/Auto.svelte";
import CargandoJuego from "../../components/CargandoJuego.astro";
import PaginaJuego from "../../layouts/PaginaJuego.astro";
import { urlImagen } from "../../lib/rutas";
import "../../styles/desafio.css";
import "../../styles/auto.css";
---

<PaginaJuego
    juego="auto"
    titulo="TCdle | Adiviná el piloto por su auto"
    descripcion="Adiviná qué piloto de Turismo Carretera conduce el auto del día."
    tituloIntro="¿Quién maneja este TC?"
>
    <img
        slot="intro-imagen"
        class="intro-juego__imagen intro-juego__imagen--auto"
        src={urlImagen("ejemplos/ejemplo-auto.webp")}
        alt="Auto de Turismo Carretera de ejemplo, mostrado con un desenfoque animado"
        width="1200"
        height="802"
        loading="lazy"
    />

    <Fragment slot="intro">
        <p class="intro-juego__texto">
            La foto de un auto de TC arranca borrosa. Decí de quién es en <strong>8 intentos</strong>: cada error la aclara un poco.
        </p>

        <fieldset class="opciones-juego">
            <legend>Dificultad</legend>
            <label><input type="radio" name="auto-modo" value="normal" checked /><span>Normal</span></label>
            <label><input type="radio" name="auto-modo" value="dificil" /><span>Difícil · en blanco y negro</span></label>
        </fieldset>
    </Fragment>

    <section slot="presentacion" class="presentacion-juego" aria-labelledby="titulo-auto">
        <h1 id="titulo-auto">¿Quién maneja este TC?</h1>
    </section>

    <Auto client:only="svelte">
        <Fragment slot="fallback">
            <CargandoJuego forma="foto" />
        </Fragment>
    </Auto>
</PaginaJuego>

<script>
    import { CLAVE_MODO_AUTO, EVENTO_MODO_AUTO, normalizarModoAuto } from "../../lib/autos";

    // La introducción arranca con el último modo elegido. "Empezar" lo recuerda y se
    // lo pasa al juego, que ya está montado detrás.
    const opciones = document.querySelectorAll<HTMLInputElement>('input[name="auto-modo"]');
    try {
        const anterior = normalizarModoAuto(localStorage.getItem(CLAVE_MODO_AUTO));
        opciones.forEach((opcion) => (opcion.checked = opcion.value === anterior));
    } catch {
        // Sin localStorage queda el normal.
    }

    document.querySelector<HTMLButtonElement>("[data-intro-clave]")?.addEventListener("click", () => {
        const modo = normalizarModoAuto([...opciones].find((opcion) => opcion.checked)?.value);
        try {
            localStorage.setItem(CLAVE_MODO_AUTO, modo);
        } catch {
            // Sin localStorage vale solo para hoy.
        }
        document.dispatchEvent(new CustomEvent(EVENTO_MODO_AUTO, { detail: modo }));
    });
</script>
