---
// "Más juegos": Conexiones TC. Las fichas de los pilotos (con victorias y temporadas
// desde las finales) se arman al construir, así la página no baja carreras.json.
import EncabezadoJuego from "../../components/EncabezadoJuego.astro";
import CargandoJuego from "../../components/CargandoJuego.astro";
import Conexiones from "../../games/extra/Conexiones.svelte";
import Pagina from "../../layouts/Pagina.astro";
import { carreras, pilotos } from "../../data";
import { construirFichas } from "../../lib/extra";
import "../../styles/juego.css";
import "../../styles/desafio.css";
import "../../styles/extra.css";

const fichas = construirFichas(pilotos, carreras);
---

<Pagina titulo="TCdle | Conexiones TC" descripcion="Dieciséis pilotos, cuatro grupos ocultos de cuatro. Elegí cuatro y probá: tenés 4 errores.">
    <EncabezadoJuego />

    <main class="juego juego--extra">
        <div class="contenido-juego contenido-juego--siempre">
            <section class="presentacion-juego" aria-labelledby="titulo-conexiones">
                <p class="modo-juego">Más juegos · Conexiones</p>
                <h1 id="titulo-conexiones">Conexiones TC</h1>
                <p>Dieciséis pilotos, cuatro grupos ocultos de cuatro. Elegí cuatro y probá: tenés 4 errores.</p>
            </section>

            <Conexiones client:only="svelte" fichas={fichas}>
                <Fragment slot="fallback">
                    <CargandoJuego forma="foto" />
                </Fragment>
            </Conexiones>
        </div>
    </main>
</Pagina>
