---
// "Más juegos": ¿De quién es esta campaña?. Las fichas de los pilotos (con victorias y temporadas
// desde las finales) se arman al construir, así la página no baja carreras.json.
import EncabezadoJuego from "../../components/EncabezadoJuego.astro";
import CargandoJuego from "../../components/CargandoJuego.astro";
import Trayectoria from "../../games/extra/Trayectoria.svelte";
import Pagina from "../../layouts/Pagina.astro";
import { carreras, pilotos } from "../../data";
import { construirFichas } from "../../lib/extra";
import "../../styles/juego.css";
import "../../styles/desafio.css";
import "../../styles/extra.css";

const fichas = construirFichas(pilotos, carreras);
---

<Pagina titulo="TCdle | ¿De quién es esta campaña?" descripcion="Marca y número de cada temporada de un piloto: cada error destapa dos años más. Tenés 6 intentos.">
    <EncabezadoJuego />

    <main class="juego juego--extra">
        <div class="contenido-juego contenido-juego--siempre">
            <section class="presentacion-juego" aria-labelledby="titulo-trayectoria">
                <p class="modo-juego">Más juegos · Trayectoria</p>
                <h1 id="titulo-trayectoria">¿De quién es esta campaña?</h1>
                <p>Marca y número de cada temporada de un piloto: cada error destapa dos años más. Tenés 6 intentos.</p>
            </section>

            <Trayectoria client:only="svelte" fichas={fichas}>
                <Fragment slot="fallback">
                    <CargandoJuego forma="foto" />
                </Fragment>
            </Trayectoria>
        </div>
    </main>
</Pagina>
