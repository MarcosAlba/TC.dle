---
import MenuApariencia from "../components/MenuApariencia.astro";
import ProximaCarrera from "../components/ProximaCarrera.astro";
import TarjetaJuego from "../components/TarjetaJuego.astro";
import Pagina from "../layouts/Pagina.astro";
import { dejarLogoQuieto } from "../lib/inicio-pagina";
import { ruta, urlImagen } from "../lib/rutas";
import "../styles/portada.css";
import { huellaScript } from "../lib/huella-script";

const scriptLogo = `(${dejarLogoQuieto})();`;
// Astro no calcula la huella de los scripts is:inline: sin esto la política de contenido lo bloquearía.
Astro.csp?.insertScriptHash(huellaScript(scriptLogo));
---

<Pagina titulo="TCdle" descripcion="Elegí uno de los ocho desafíos diarios de TCdle." claseBody="portada">
    <header class="encabezado-inicio">
        <img class="logo-inicio logo-inicio--normal" src={urlImagen("tcdle-logo-frenada.svg")} alt="TCdle" width="1570" height="384" />
        <img class="logo-inicio logo-inicio--halloween" src={urlImagen("tcdle-logo-frenada-halloween.svg")} alt="TCdle" width="1570" height="549" />
        <MenuApariencia />
    </header>
    <!-- Corre antes del primer pintado: desde la segunda vez en la sesión el logo ya aparece terminado. -->
    <script is:inline set:html={scriptLogo} />

    <main class="inicio">
        <section class="selector-juegos" aria-labelledby="titulo-selector">
            <!-- En PC el título va a la izquierda con la fecha y, a la derecha, cuántos juegos se completaron hoy. -->
            <div class="selector-juegos__cabecera">
                <div class="selector-juegos__titulo">
                    <p id="fecha-hoy" class="selector-juegos__fecha"></p>
                    <h1 id="titulo-selector">
                        <span class="selector-juegos__titulo-celular">Elegí un juego</span>
                        <span class="selector-juegos__titulo-pc">Desafíos de hoy</span>
                    </h1>
                </div>
                <div id="progreso-dia" class="progreso-dia" hidden>
                    <p class="progreso-dia__texto"><span>Completados</span> <b id="progreso-dia-cuenta"></b></p>
                    <span class="progreso-dia__barra" aria-hidden="true">
                        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                    </span>
                    <!-- Con los ocho terminados: el resumen del día en un solo mensaje. -->
                    <button id="compartir-dia" class="progreso-dia__compartir" type="button" hidden>Compartir el día</button>
                </div>
            </div>

            <div class="grilla-juegos">
                <TarjetaJuego juego="piloto">
                    <img
                        src={urlImagen("pilotos/mini/julian_santero.webp")}
                        srcset={`${urlImagen("pilotos/mini/julian_santero.webp")} 240w, ${urlImagen("pilotos/julian_santero.webp")} 500w`}
                        sizes="(max-width: 700px) 340px, 228px"
                        alt="Julián Santero"
                        width="240"
                        height="240"
                    />
                </TarjetaJuego>

                <TarjetaJuego juego="auto">
                    <img
                        src={urlImagen("portada/auto-480.webp")}
                        srcset={`${urlImagen("portada/auto-480.webp")} 480w, ${urlImagen("autos/agustin_canapino_2026.webp")} 915w`}
                        sizes="(max-width: 700px) 340px, 228px"
                        alt="Auto de Agustín Canapino"
                        width="480"
                        height="472"
                    />
                </TarjetaJuego>

                <TarjetaJuego juego="circuito">
                    <img
                        src={urlImagen("circuitos/buenos-aires-12-sin-chicana.svg")}
                        alt="Silueta del Autódromo Oscar Cabalén"
                    />
                </TarjetaJuego>

                <TarjetaJuego juego="wordle">
                    <span class="tarjeta-juego__letras" aria-hidden="true">
                        <span>T</span><span>C</span><span>D</span><span>L</span><span>E</span>
                    </span>
                </TarjetaJuego>

                <TarjetaJuego juego="top10">
                    <span class="tarjeta-juego__podio" aria-hidden="true">
                        <span><img src={urlImagen("marcas/chevrolet-clasico.png")} alt="" /><b>2</b></span>
                        <span><img src={urlImagen("marcas/ford-clasico.png")} alt="" /><b>1</b></span>
                        <span><img src={urlImagen("marcas/torino-clasico.png")} alt="" /><b>3</b></span>
                    </span>
                </TarjetaJuego>

                <TarjetaJuego juego="trayectoria">
                    <img class="tarjeta-juego__silueta" src={urlImagen("silueta-piloto.webp")} alt="" />
                    <span class="tarjeta-juego__anios" aria-hidden="true">
                        <span><small>2010</small><img src={urlImagen("marcas/ford-clasico.png")} alt="" /><b>#14</b></span>
                        <span><small>2011</small><img src={urlImagen("marcas/chevrolet-clasico.png")} alt="" /><b>#7</b></span>
                        <span class="tarjeta-juego__anio-oculto"><small>2012</small><i>?</i><b>#?</b></span>
                    </span>
                </TarjetaJuego>

                <TarjetaJuego juego="grilla">
                    <span class="tarjeta-juego__tablero" aria-hidden="true">
                        <i><img src={urlImagen("pilotos/mini/julian_santero.webp")} alt="" /></i><i>+</i><i>+</i>
                        <i>+</i><i><img src={urlImagen("pilotos/mini/agustin_canapino.webp")} alt="" /></i><i>+</i>
                        <i>+</i><i>+</i><i><img src={urlImagen("pilotos/mini/mariano_werner.webp")} alt="" /></i>
                    </span>
                </TarjetaJuego>

                <TarjetaJuego juego="conexiones">
                    <span class="tarjeta-juego__conexiones" aria-hidden="true">
                        <span class="tarjeta-juego__grupo">¿Qué tienen en común?</span>
                        <i><img src={urlImagen("pilotos/mini/matias_rossi.webp")} alt="" /></i>
                        <i><img src={urlImagen("pilotos/mini/guillermo_ortelli.webp")} alt="" /></i>
                        <i><img src={urlImagen("pilotos/mini/facundo_ardusso.webp")} alt="" /></i>
                        <i><img src={urlImagen("pilotos/mini/christian_ledesma.webp")} alt="" /></i>
                        <i><img src={urlImagen("pilotos/mini/jose_manuel_urcera.webp")} alt="" /></i>
                        <i><img src={urlImagen("pilotos/mini/juan_martin_trucco.webp")} alt="" /></i>
                        <i><img src={urlImagen("pilotos/mini/diego_de_carlo.webp")} alt="" /></i>
                        <i><img src={urlImagen("pilotos/mini/german_todino.webp")} alt="" /></i>
                    </span>
                </TarjetaJuego>
            </div>
        </section>

        <ProximaCarrera />

        <a class="enlace-archivo" href={ruta("archivo.html")}>Jugar días anteriores</a>
    </main>


    <script>
        import "../scripts/portada";
    </script>
</Pagina>
