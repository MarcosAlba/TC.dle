---
// Tarjeta de un juego en la portada. La imagen va en el slot; la insignia de
// racha viene oculta y la completa src/scripts/portada.ts con lo guardado.
import { obtenerJuego, type JuegoId } from "../lib/juegos";
import { urlJuego } from "../lib/rutas";

interface Props {
    juego: JuegoId;
}

const { juego: id } = Astro.props;
const juego = obtenerJuego(id);
---

<a class={`tarjeta-juego tarjeta-juego--${id}`} href={urlJuego(juego.archivo)} data-juego={id}>
    <span class="tarjeta-juego__imagen"><slot /></span>
    <span class="tarjeta-juego__contenido">
        <strong class="tarjeta-juego__nombre">{juego.nombre}</strong>
        <span class="tarjeta-juego__jugar" aria-hidden="true">Jugar</span>
    </span>
    <span class="tarjeta-juego__racha" hidden>
        <svg class="tarjeta-juego__racha-icono" viewBox="0 0 24 24" aria-hidden="true"><use href="#bandera-cuadros"></use></svg>
        <span data-racha></span>
    </span>
</a>
