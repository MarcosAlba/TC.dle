---
// Pie de todas las páginas: una línea fina arriba, el logo chico, los links y, a la
// derecha, que TCdle es de fans y no de la ACTC y de quién son las fotos. Tiene que
// pasar desapercibido: nada de colores ni carteles.
import { ruta, urlImagen, urlInicio } from "../lib/rutas";
import { urlCafecito } from "../lib/sitio";
import "../styles/pie.css";

interface Props {
    /** En las páginas de juego: sin el aviso (que queda en la portada y en Acerca de). */
    compacto?: boolean;
}

const { compacto = false } = Astro.props;
const cafecito = urlCafecito();
---

<footer class:list={["pie-sitio", { "pie-sitio--compacto": compacto }]}>
    <a class="pie-sitio__logo" href={urlInicio()} aria-label="TCdle, inicio">
        <img src={urlImagen("tcdle-logo-336.webp")} alt="" width="336" height="82" loading="lazy" />
    </a>
    <nav class="pie-sitio__links" aria-label="Más de TCdle">
        <a href={ruta("acerca.html")}>Acerca de</a>
        <a href={ruta("archivo.html")}>Días anteriores</a>
        {
            cafecito && (
                <a href={cafecito} target="_blank" rel="noopener">
                    Invitame un cafecito
                </a>
            )
        }
    </nav>
    {!compacto && <p class="pie-sitio__aviso">TCdle es un juego hecho por fans. Sin relación con la ACTC. Fotos: ACTC y sus autores.</p>}
</footer>
